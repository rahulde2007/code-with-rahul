# Dependencies
**/node_modules/

# Production build output
/dist/
/build/

# Local environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Cache and temporary files
**/.cache/
**/.temp/
**/.tmp/
**/.vite/
**/.npm/
**/.parcel-cache/
**/*.tmp
**/*.bak
**/*.tsbuildinfo
**/.eslintcache

# Test and coverage output
**/coverage/
**/.nyc_output/

# Operating system files
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# Editor and local tooling files
**/.idea/
**/.vscode-test/
