# Contact form delivery
# Create a Formspree form and set its verified recipient to rahulde937@gmail.com.
# Copy its form ID into .env.local (or your deployment's environment settings).
# Formspree: https://formspree.io/

VITE_FORMSPREE_FORM_ID=your_formspree_form_id_here
# Server-side only; never use a VITE_ prefix or expose this token to the browser.
GITHUB_TOKEN=your_github_personal_access_token_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
